<?xml version="1.0" ?>
<!--
  Runway world for the Wingbreaker interceptor stack.

  Based on the reference external_world.sdf pattern (wing_braker_uav) and
  PX4's default.sdf (Tools/simulation/gz/worlds). Adds a static runway
  model referenced from ~/Downloads/runway.glb near the patrol box centre.

  Spawn the UAV with PX4_GZ_WORLD=runway_world (the wingbreaker launch
  file already sets this).
-->
<sdf version='1.9'>
  <world name='runway_world'>

    <physics type='ode'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <light name='sunUTC' type='directional'>
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <material>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0 0 0 1</specular>
            <ambient>0.4 0.4 0.4 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name='riyadh_glb'>
      <static>true</static>
      <!-- Visual-only terrain: collision removed so the PX4 FW isn't trapped
           inside the terrain mesh at spawn (which broke arming with "Resolve
           system health failures"). ground_plane below still catches the
           vehicle; terrain renders as scenery. -->
      <pose>0 0 0 1.5708 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>/home/khalid/Downloads/riyadh_srtm__mapbox_sat.glb</uri>
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name='runway'>
      <static>true</static>
      <!--
        TODO: tune pose/scale to match runway.glb's own coordinate frame.
        Placed near the patrol box centre (37 E, 33 N in gz coords ~= Zurich
        lat/lon box). Z slightly above ground to avoid z-fighting.
      -->
      <pose>37 33 0.05 0 1.5708 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>/home/khalid/Downloads/runway.glb</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>/home/khalid/Downloads/runway.glb</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
